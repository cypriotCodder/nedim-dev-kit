{
  "rubricVersion": 2,
  "weights": { "security": 30, "reliability": 25, "performance": 15, "maintainability": 20, "tooling": 10 },
  "metricCaps": [
    { "id": "secret-in-repo", "category": "security", "max": 5, "tools": ["patterns", "exceptions"] },
    { "id": "secret-in-history", "category": "security", "max": 5, "tools": ["gitleaks"] },
    { "id": "tests-failing", "category": "reliability", "max": 5, "tools": ["tests"] },
    { "id": "type-errors", "category": "maintainability", "max": 6, "tools": ["typecheck"] },
    { "id": "strict-off", "category": "maintainability", "max": 7, "tools": ["strict"] },
    { "id": "many-cycles-or-violations", "category": "maintainability", "max": 6, "tools": ["boundaries"] },
    { "id": "duplication-over-8", "category": "maintainability", "max": 6, "tools": ["duplication"] },
    { "id": "duplication-over-4", "category": "maintainability", "max": 8, "tools": ["duplication"] },
    { "id": "many-huge-files", "category": "maintainability", "max": 6, "tools": ["hotspots"] },
    { "id": "no-lockfile", "category": "tooling", "max": 4, "tools": [] },
    { "id": "env-file-with-secrets", "category": "tooling", "max": 4, "tools": ["exceptions"] },
    { "id": "no-ci", "category": "tooling", "max": 6, "tools": [] },
    { "id": "no-claude-md", "category": "tooling", "max": 7, "tools": [] }
  ],
  "rules": {
    "security": {
      "missing-authz-on-mutation": 4,
      "hardcoded-secret": 5,
      "reachable-vulnerable-dependency": 6,
      "no-boundary-validation": 6,
      "no-auth-rate-limit": 7,
      "missing-authentication": null,
      "idor-read": null,
      "missing-validation": null,
      "sql-injection": null,
      "command-injection": null,
      "path-traversal": null,
      "xss": null,
      "ssrf": null,
      "csrf": null,
      "cors-misconfiguration": null,
      "open-redirect": null,
      "weak-session-or-jwt": null,
      "weak-password-storage": null,
      "secret-in-client": null,
      "sensitive-data-exposure": null,
      "insecure-upload": null,
      "webhook-unverified": null,
      "missing-security-headers": null,
      "tls-disabled": null,
      "missing-abuse-limit": null,
      "other-security": null
    },
    "reliability": {
      "no-critical-flow-tests": 4,
      "non-transactional-writes": 5,
      "external-call-no-timeout": 6,
      "env-not-validated": 7,
      "no-production-observability": 7,
      "swallowed-error": null,
      "unhandled-rejection": null,
      "missing-idempotency": null,
      "race-condition": null,
      "unsafe-retry": null,
      "no-graceful-shutdown": null,
      "unsafe-migration": null,
      "weak-tests": null,
      "silent-background-failure": null,
      "time-or-money-handling": null,
      "other-reliability": null
    },
    "performance": {
      "n-plus-one": 5,
      "unbounded-query": 5,
      "missing-index": 6,
      "no-pagination": 6,
      "blocking-request-path": null,
      "missing-cache": null,
      "over-fetching": null,
      "heavy-bundle": null,
      "render-churn": null,
      "resource-leak": null,
      "connection-handling": null,
      "other-performance": null
    },
    "maintainability": {
      "competing-implementations": 7,
      "boundary-violation": null,
      "architecture-doc-mismatch": null,
      "logic-in-wrong-layer": null,
      "duplication": null,
      "god-file": null,
      "dead-code": null,
      "weak-types": null,
      "inconsistent-pattern": null,
      "weak-test-design": null,
      "other-maintainability": null
    },
    "tooling": {
      "ci-missing-checks": 6,
      "no-check-command": 7,
      "claude-md-contradicts-code": 7,
      "conflicting-agent-setup": 8,
      "dependency-hygiene": null,
      "runtime-not-pinned": null,
      "docker-hygiene": null,
      "undocumented-env": null,
      "missing-lint-or-format": null,
      "no-guardrails": null,
      "agent-setup-gap": null,
      "other-tooling": null
    }
  }
}
