{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-node.sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/post-edit.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-node.sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/stop-check.mjs",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
